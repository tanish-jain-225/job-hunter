# ==============================================================================
# Job Hunter (.env) - Provider & Delivery Credentials
# ==============================================================================

# Primary LLM Provider: gemini | groq | anthropic | openai-compatible | ollama
LLM_PROVIDER=gemini

# Google Gemini (Free tier recommended)
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-2.0-flash
DRAFT_MODEL=gemini-2.0-flash

# Groq (Optional ultra-fast provider)
# GROQ_API_KEY=gsk_...
# SCREEN_MODEL=llama-3.3-70b-versatile
# DRAFT_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (Optional frontier provider)
# ANTHROPIC_API_KEY=sk-ant-...
# SCREEN_MODEL=claude-3-5-haiku-20241022
# DRAFT_MODEL=claude-3-7-sonnet-20250219

# Local Ollama (Optional 100% offline free provider)
# OLLAMA_HOST=http://localhost:11434
# SCREEN_MODEL=llama3.1
# DRAFT_MODEL=llama3.1

# SMTP Email Dispatch (Gmail: use 16-char App Password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_TO=your-email@gmail.com