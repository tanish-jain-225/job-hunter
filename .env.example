# ==============================================================================
# Job Hunter — Environment Configuration Template (.env.example)
# ==============================================================================

# AI Intelligence Provider (Google Gemini Flash — 1M Tokens/Day per project)
# • GEMINI_API_KEY: High-throughput screening & tailored application kit drafting (aistudio.google.com)
# Supports comma-separated keys for instant multi-key rotation: key1,key2,key3
GEMINI_API_KEY=AIzaSy_paste_your_gemini_api_key_here

# Central Outbound SMTP Server (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Supabase PostgreSQL Multi-Tenant Database & Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AUTH_REQUIRED=true

# GitHub Actions Workflow Dispatch (Cloud On-Demand Radar)
GH_TOKEN=github_pat_your_personal_access_token_here
GITHUB_REPOSITORY=your-github-username/job-hunter

# ------------------------------------------------------------------------------
# Optional Configuration
# ------------------------------------------------------------------------------
# Flask secret key for consistent session signing across serverless instances (generate via: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=replace-with-a-random-32-character-secret-key

# Storage & Database Sliding Window Limits (default: 300 unapplied jobs)
# MAX_TRACKED_JOBS_COUNT=300
# MAX_JOBS_TO_SCREEN=24
# MAX_PER_DIGEST=7

# Optional: Stage / Provider overrides
# LLM_PROVIDER=gemini
# SCREEN_MODEL=gemini-3.7-flash
# DRAFT_MODEL=gemini-3.7-flash

# Optional: Alternative AI Providers (override LLM_PROVIDER to activate)
# Anthropic Claude  — pip install 'jobhunt[anthropic]'
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# LLM_PROVIDER=anthropic

# Groq (ultra-fast free inference)
# GROQ_API_KEY=gsk_your-groq-api-key-here
# LLM_PROVIDER=groq

# Ollama (fully local, no key needed)
# OLLAMA_HOST=http://localhost:11434
# LLM_PROVIDER=ollama

# Optional: Supabase JWT secret for instant offline HMAC verification
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret