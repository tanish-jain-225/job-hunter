# ==============================================================================
# jobhunt - End-to-End .gitignore
# ==============================================================================

# --- Secrets & Personal Data  --------------------------------------------------
.env
.env.local
.env.*.local
*.env

resume.*
my_resume.*
*.pdf
*.docx
profile.json
!profile.example.json

seen.json
seen.tmp
*.json.tmp

# --- Generated Output & Artifacts ---------------------------------------------
out/
*.html
!templates/*.html
!templates/**/*.html
!jobhunt/templates/*.html
digest.html
*.csv

# --- Python Bytecode & Environments -------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Build, Distribution & Packaging ------------------------------------------
*.egg-info/
.egg-info/
dist/
build/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
MANIFEST

# --- Testing, Coverage & Quality Caches ---------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# --- Editors, IDEs & OS Files -------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- AI Assistants & Temporary Workspace Files --------------------------------
.claude/
.gemini/
*.log
tmp/
temp/
